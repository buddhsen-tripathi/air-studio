# Copy to .env.local and fill in.
#
# Both AI features (the arranger and the coach) work without these — they fall
# back to a deterministic offline implementation. Set the key to get real
# model-written arrangements and coaching.

# Your OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model slug OpenRouter serves. Needs to be decent at instruction-following
# and JSON output. Defaults to anthropic/claude-sonnet-4.5 if unset.
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Reasoning effort for models that support it: minimal | low | medium | high | off.
# Defaults to "minimal", and that default is load-bearing. Measured on
# openai/gpt-5-nano with our chart prompt: at default effort the model burned its
# entire 4000-token budget on reasoning and returned NO content after 57s; at
# "minimal" it answers in 5.4s with zero reasoning tokens. Our prompts already do
# the structural work, so there is little left to reason about.
OPENROUTER_REASONING_EFFORT=minimal

# Optional attribution shown on your OpenRouter dashboard.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Air Studio